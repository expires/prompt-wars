{
  "name": "@ai-gaem/forge",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Forge service: streams LLM-designed weapons (Forge DSL) as NDJSON at /api/forge/*",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "integration": "tsx scripts/integration.ts",
    "render": "tsx scripts/render.ts",
    "samples": "tsx scripts/samples.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ai-gaem/parts": "workspace:*",
    "@ai-gaem/shared": "workspace:*",
    "@anthropic-ai/sdk": "^0.131.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
